#!/bin/sh
# Checks local rundevrun update and rollback behavior in a disposable repository.
set -eu
source_repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
test_root=$(mktemp -d "${TMPDIR:-/tmp}/rdr-install-test.XXXXXXXX")
trap 'rm -rf "$test_root"' EXIT
trap 'exit 1' HUP INT TERM
mkdir -p "$test_root/repo/scripts" "$test_root/bin"
cp "$source_repo/scripts/rdr-local" "$test_root/repo/scripts/"
cp -R "$source_repo/.githooks" "$test_root/repo/"
cd "$test_root/repo"
git init -q -b main
git config user.name Test
git config user.email test@example.invalid
echo committed > marker
git add .
git commit -qm initial
echo dirty > marker
cat > "$test_root/bin/go" <<'EOF'
#!/bin/sh
set -eu
[ "$(cat marker)" = "${EXPECT_MARKER:-dirty}" ]
[ "${FAIL_BUILD:-0}" = 0 ] || exit 1
while [ "$1" != -o ]; do shift; done
shift
printf '#!/bin/sh\necho "%s"\n' "${BUILD_LABEL:-new}" > "$1"
chmod +x "$1"
if [ "${FAIL_SMOKE:-0}" = 1 ]; then
    printf '#!/bin/sh\nexit 1\n' > "$1"
fi
EOF
chmod +x "$test_root/bin/go"
export PATH="$test_root/bin:$PATH"
export RDR_INSTALL_DIR="$test_root/install"
mkdir "$RDR_INSTALL_DIR"
printf '#!/bin/sh\necho old\n' > "$RDR_INSTALL_DIR/rdr"
chmod +x "$RDR_INSTALL_DIR/rdr"
./scripts/rdr-local update
[ "$("$RDR_INSTALL_DIR/rundevrun")" = new ]
[ "$("$RDR_INSTALL_DIR/rundevrun.previous")" = old ]
[ "$("$RDR_INSTALL_DIR/rdr")" = old ]
./scripts/rdr-local update
[ "$("$RDR_INSTALL_DIR/rundevrun.previous")" = old ]
if FAIL_BUILD=1 ./scripts/rdr-local update; then exit 1; fi
if FAIL_SMOKE=1 ./scripts/rdr-local update; then exit 1; fi
[ "$("$RDR_INSTALL_DIR/rundevrun")" = new ]
[ "$("$RDR_INSTALL_DIR/rundevrun.previous")" = old ]
./scripts/rdr-local rollback
./scripts/rdr-local rollback
[ "$("$RDR_INSTALL_DIR/rundevrun")" = old ]
mkdir "$RDR_INSTALL_DIR/.install-lock"
if ./scripts/rdr-local update; then exit 1; fi
rmdir "$RDR_INSTALL_DIR/.install-lock"
git branch feature
git worktree add -q "$test_root/feature" feature
cd "$test_root/feature"
echo feature-dirty > marker
EXPECT_MARKER=feature-dirty BUILD_LABEL=feature ./scripts/rdr-local update
[ "$("$RDR_INSTALL_DIR/rundevrun")" = feature ]
BUILD_LABEL=unexpected ./.githooks/post-merge
BUILD_LABEL=unexpected ./.githooks/post-rewrite rebase
[ "$("$RDR_INSTALL_DIR/rundevrun")" = feature ]
EXPECT_MARKER=committed BUILD_LABEL=committed ./scripts/rdr-local update --committed
[ "$("$RDR_INSTALL_DIR/rundevrun")" = committed ]
cd "$test_root/repo"
EXPECT_MARKER=committed BUILD_LABEL=merge ./.githooks/post-merge
[ "$("$RDR_INSTALL_DIR/rundevrun")" = merge ]
EXPECT_MARKER=committed BUILD_LABEL=rebase ./.githooks/post-rewrite rebase
[ "$("$RDR_INSTALL_DIR/rundevrun")" = rebase ]
rm "$RDR_INSTALL_DIR/rundevrun.previous"
if ./scripts/rdr-local rollback; then exit 1; fi
echo 'PASS: worktree source, committed source, update, unchanged update, build/smoke failure, rollback, lock, main-only hooks, missing backup'
