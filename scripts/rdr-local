#!/bin/sh
# Installs rundevrun from this worktree or restores the previous local binary.
set -eu

action=${1:-}
case "$action:${2:-}:$#" in
    update::1|update:--committed:2|rollback::1) ;;
    *) echo "Usage: $0 update [--committed] | rollback" >&2; exit 2 ;;
esac

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
dest=${RDR_INSTALL_DIR:-"$HOME/.local/opt/rundevrun"}
mkdir -p "$dest"
lock="$dest/.install-lock"
if ! mkdir "$lock" 2>/dev/null; then
    echo "Another install is active, or a stale lock exists: $lock" >&2
    exit 1
fi
work=
cleanup() {
    [ -z "$work" ] || rm -rf "$work"
    rm -rf "$lock"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if [ "$action" = rollback ]; then
    if [ ! -f "$dest/rundevrun.previous" ]; then
        echo "No previous binary at $dest/rundevrun.previous" >&2
        exit 1
    fi
    cp -p "$dest/rundevrun.previous" "$lock/rundevrun"
    "$lock/rundevrun" version --json
    mv -f "$lock/rundevrun" "$dest/rundevrun"
    echo "Rolled back $dest/rundevrun"
    exit 0
fi

revision=$(git -C "$repo" rev-parse HEAD)
source=$repo
if [ "${2:-}" = --committed ]; then
    work=$(mktemp -d "${TMPDIR:-/tmp}/rdr-install.XXXXXXXX")
    git -C "$repo" archive --format=tar -o "$work/source.tar" "$revision"
    mkdir "$work/source"
    tar -xf "$work/source.tar" -C "$work/source"
    source="$work/source"
elif [ -n "$(git -C "$repo" status --porcelain)" ]; then
    revision="$revision.dirty"
fi
(
    cd "$source"
    go build -trimpath -ldflags "-X github.com/bettertomorrow-dev/rundevrun/internal/cli.Version=0.1.0-dev+$revision" -o "$lock/rundevrun" ./cmd/rundevrun
)
"$lock/rundevrun" version --json
"$lock/rundevrun" --help >/dev/null
if [ -f "$dest/rundevrun" ] && cmp -s "$dest/rundevrun" "$lock/rundevrun"; then
    echo "Already installed: $revision"
    exit 0
fi
previous="$dest/rundevrun"
if [ ! -f "$previous" ] && [ -f "$dest/rdr" ]; then
    previous="$dest/rdr"
fi
if [ -f "$previous" ]; then
    cp -p "$previous" "$lock/previous"
    mv -f "$lock/previous" "$dest/rundevrun.previous"
fi
mv -f "$lock/rundevrun" "$dest/rundevrun"
echo "Installed $revision at $dest/rundevrun"
